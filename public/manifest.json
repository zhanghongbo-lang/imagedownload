{
  "manifest_version": 3,
  "name": "电商图片提取下载",
  "version": "1.0.0",
  "description": "在淘宝、京东、拼多多商品详情页一键提取并下载商品图片（PNG 格式）。",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://taobao.com/*",
    "*://*.taobao.com/*",
    "*://tmall.com/*",
    "*://*.tmall.com/*",
    "*://*.alicdn.com/*",
    "*://*.taobaocdn.com/*",
    "*://jd.com/*",
    "*://*.jd.com/*",
    "*://*.360buyimg.com/*",
    "*://pinduoduo.com/*",
    "*://*.pinduoduo.com/*",
    "*://yangkeduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.pddpic.com/*",
    "*://*.psstatp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://taobao.com/*",
        "*://*.taobao.com/*",
        "*://tmall.com/*",
        "*://*.tmall.com/*",
        "*://jd.com/*",
        "*://*.jd.com/*",
        "*://pinduoduo.com/*",
        "*://*.pinduoduo.com/*",
        "*://yangkeduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "电商图片提取下载",
    "default_popup": "app/index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
